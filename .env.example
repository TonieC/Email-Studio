# Copy to .env and fill in real values. Never commit .env.

# Base URL of this instance, used for Gmail OAuth redirects and links.
# Behind a reverse proxy set this to the public HTTPS URL.
PUBLIC_BASE_URL=http://localhost:3000

# Session signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# AES-256-GCM key used to encrypt OAuth/SMTP credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a key is auto-generated and stored under data/keys/encryption.key.
APP_ENCRYPTION_KEY=

# Server port and data directory (data/ is persisted and backed up).
PORT=3000
DATA_DIR=./data

# Set to true when serving over HTTPS (Docker healthcheck/proxy setups).
COOKIE_SECURE=false
TRUST_PROXY=true

# Gmail OAuth 2.0 (Google Cloud Console).
#   - Create an OAuth client ID of type "Web application"
#   - Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI
#   - Enable the Gmail API for the project
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# Optional: inline small assets as base64 during conversion instead of linking to this instance.
CONVERT_INLINE_ASSETS=false

# Optional: max upload size for images in bytes (default 5 MiB).
MAX_UPLOAD_BYTES=5242880
